<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  See checkstyle.xml for why this ruleset is vendored rather than fetched from a URL. The
  non-backlog entries below are adapted from wso2/code-quality-tools' own generic suppressions
  (Javadoc laxness for tests, generated-code exclusion); the backlog entries are specific to this
  repo - see wso2/dpdp-accelerator#276.
-->
<suppressions>

    <!-- wso2/dpdp-accelerator#276: pre-existing violations across the tree, too large to fix in
         the PR that added this gate. Remove each line as its backlog is cleared. -->
    <suppress checks="LineLength" files=".*"/>

    <suppress checks="Javadoc.*" files=".*/src/test/java/.*"/>
    <suppress checks="JavadocStyle" files=".*/src/(main|internal)/java/.*"/>

    <!-- Generated from an OpenAPI spec - see CLAUDE.md, "Generated DTOs". -->
    <suppress checks=".*" files=".*/src/gen/java/.*"/>

    <!-- Allow v1_1 package naming for minor-versioned API endpoints -->
    <suppress checks="PackageName" files=".*/v1_1/.*"/>

</suppressions>
