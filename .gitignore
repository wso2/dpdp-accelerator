# Compiled class file
*.class

# Log file
*.log

# Package files (build outputs live under target/)
hs_err_pid*
replay_pid*

# Maven
target/
**/target/
release.properties
pom.xml.releaseBackup

# Node
**/node_modules/
**/frontend/dist/
**/frontend/npm/
npm-debug.log*

# Docusaurus (docs site build output and cache)
docs/.docusaurus/
docs/build/

# Accelerator overlay: the exploded webapp and OSGi bundle jars are generated
# at package time.
**/carbon-home/repository/deployment/server/webapps/
**/carbon-home/repository/components/dropins/*.jar
*.jar

# openapi-generator's own change-tracking cache - src/gen/java itself is committed,
# this file isn't needed to regenerate it.
**/.openapi-generator/

# IDE
.idea/
*.iml
.vscode/
.claude/
.classpath
.project
.settings/
.DS_Store

# Env
.env
.env.local
