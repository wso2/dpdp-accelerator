<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>react-apps</artifactId>
        <version>1.0.0-alpha1</version>
    </parent>

    <artifactId>consent-portal</artifactId>
    <packaging>war</packaging>
    <name>WSO2 DPDP Accelerator - Consent Portal Webapp</name>

    <!--
      The webapp carries no Java of its own: it is the built single page
      application plus the JSP shell that serves it. The servlet API is needed
      only so the container can compile those JSPs.
    -->
    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npm.executable}</executable>
                            <arguments>
                                <argument>install</argument>
                                <argument>--no-audit</argument>
                                <argument>--no-fund</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npm.executable}</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <environmentVariables>
                        <CI>false</CI>
                        <!--
                          Deployed inside the Identity Server the APIs are
                          same-origin and tenant-qualified, so the base is
                          resolved from the browser URL at runtime rather than
                          being baked in here.
                        -->
                        <VITE_IS_BASE_URL></VITE_IS_BASE_URL>
                        <VITE_BASE_PATH>${portal.context.path}/</VITE_BASE_PATH>
                        <VITE_AUTH_ENABLED>true</VITE_AUTH_ENABLED>
                        <!-- Sandbox npm caches inside the module to keep CI builds hermetic. -->
                        <NPM_CONFIG_PREFIX>${basedir}/frontend/npm</NPM_CONFIG_PREFIX>
                        <NPM_CONFIG_CACHE>${basedir}/frontend/npm/cache</NPM_CONFIG_CACHE>
                        <NPM_CONFIG_TMP>${basedir}/frontend/npm/tmp</NPM_CONFIG_TMP>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webXml>${basedir}/web.xml</webXml>
                    <warName>consent-portal</warName>
                    <webResources>
                        <resource>
                            <directory>frontend/dist</directory>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <portal.context.path>/consent-portal</portal.context.path>
    </properties>
</project>
