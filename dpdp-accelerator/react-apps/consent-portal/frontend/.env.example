# Base URL the SPA uses to call the BFF. For the WAR deployment inside WSO2
# Identity Server this is the webapp's own context path (same origin).
VITE_API_BASE_URL=/consent-portal
# Public base path the SPA is served from (Vite `base`).
VITE_BASE_PATH=/consent-portal/
VITE_AUTH_ENABLED=true
VITE_AUTH_ACCESS_TOKEN_PART1_COOKIE=portal-at-p1
VITE_AUTH_REFRESH_TOKEN_PART1_COOKIE=portal-rt-p1
VITE_AUTH_ID_TOKEN_PART1_COOKIE=portal-id-p1
VITE_AUTH_ID_TOKEN_PART2_COOKIE=portal-id-p2
# Origins the portal may navigate to on logout (the Identity Server host).
VITE_AUTH_LOGOUT_ALLOWED_ORIGINS=https://localhost:9443
# Nomination CRUD goes through the BFF's same-origin passthrough: Nominee
# Service serves plain http, which the browser blocks as mixed content from an
# https page, and its CORS allowlist does not name this origin.
VITE_NOMINEE_SERVICE_BASE_URL=/consent-portal/nominee-service