{
  "name": "dpdp-consent-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run security:verify && npm run i18n:verify && npm run generate:shell",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "security:audit": "node scripts/audit-production-dependencies.mjs",
    "security:verify": "node scripts/verify-production-security.mjs",
    "i18n:verify": "node scripts/verify-i18n-completeness.mjs",
    "preview": "vite preview",
    "generate:shell": "node scripts/generate-jsp-shell.mjs"
  },
  "dependencies": {
    "@asgardeo/auth-spa": "3.5.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@tanstack/react-query": "5.102.8",
    "@wso2/oxygen-ui": "0.13.1",
    "@wso2/oxygen-ui-icons-react": "0.13.1",
    "i18next": "26.4.1",
    "i18next-http-backend": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.2",
    "react-router-dom": "7.18.3",
    "stylis": "4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/stylis": "4.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.4",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
