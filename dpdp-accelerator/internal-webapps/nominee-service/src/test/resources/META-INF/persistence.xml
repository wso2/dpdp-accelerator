<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <!-- Used only to generate the dialect scripts in dbscripts/ from the entity
       definitions. The service itself is configured by Spring, not by this. -->
  <persistence-unit name="nominee-schema-gen" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.openfgc.nomineeservice.domain.Nomination</class>
    <class>com.openfgc.nomineeservice.domain.NomineeAuditEvent</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
  </persistence-unit>
</persistence>
