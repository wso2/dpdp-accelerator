<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>WSO2 DPDP Complaint Server</display-name>

    <listener>
        <listener-class>org.wso2.dpdp.accelerator.complaint.mgt.endpoint.config.AppContextListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>ComplaintServerJerseyServlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.classnames</param-name>
            <param-value>
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.ComplaintEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.ComplaintTimelineEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.ComplaintCommentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.ComplaintAttachmentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.ComplaintCommentAttachmentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.exception.ComplaintExceptionMapper,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.filter.CorsFilter,
                org.glassfish.jersey.media.multipart.MultiPartFeature,
                org.glassfish.jersey.jackson.JacksonFeature
            </param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>ComplaintServerJerseyServlet</servlet-name>
        <url-pattern>/v1/*</url-pattern>
    </servlet-mapping>

    <!--
        Backed by a Tomcat-managed connection pool declared in META-INF/context.xml. See DBUtil
        in the DAO module for the JNDI lookup.
    -->
    <resource-ref>
        <res-ref-name>jdbc/ComplaintDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

</web-app>