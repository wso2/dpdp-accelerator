<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>dpdp-accelerator</artifactId>
        <version>1.0.0-alpha1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.service</artifactId>
    <packaging>bundle</packaging>

    <name>WSO2 DPDP Accelerator - Complaint Management Service</name>

    <dependencies>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.dao</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.common</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
             DPDPConfigParser (org.wso2.dpdp.accelerator.common, used by StatutoryDuePeriodPolicy
             via DPDPConfigurationService) touches these at class-init time. All three are
             `provided` scope there - supplied by Carbon's own classloader at actual runtime (this
             webapp's Environments now includes Carbon - see webapp-classloading.xml), never
             bundled into the WAR - but `provided` isn't transitive, so Maven's own test JVM needs
             them declared directly here too, same as commons-logging above.
        -->
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
            <scope>test</scope>
            <!-- carbon.utils's test-scope transitive deps pull in the vanilla
                 org.ops4j.pax.logging:pax-logging-api, a different artifact from WSO2's own fork
                 with an incompatible same-named PaxLogger class - can throw NoSuchMethodError at
                 test time. Excluded; nothing here needs it. -->
            <exclusions>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.ws.commons.axiom.wso2</groupId>
            <artifactId>axiom</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wso2.securevault</groupId>
            <artifactId>org.wso2.securevault</artifactId>
            <scope>test</scope>
            <!-- Same pax-logging clash as carbon.utils above, plus a second axiom copy
                 (axiom-api/axiom-impl) redundant with the axiom dependency below. -->
            <exclusions>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.event</artifactId>
            <!-- Same pax-logging clash as org.wso2.carbon.utils below. -->
            <exclusions>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Needed by EmailNotificationClient to resolve recipients directly - provided, already
             on Carbon's OSGi classpath at runtime. -->
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.user.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.core</artifactId>
            <!-- Same pax-logging clash as org.wso2.carbon.identity.event above. -->
            <exclusions>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.mgt</artifactId>
            <!-- Same pax-logging clash as org.wso2.carbon.identity.event above, via a different
                 transitive path - both pax-logging artifacts here. -->
            <exclusions>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.ops4j.pax.logging</groupId>
                    <artifactId>pax-logging-log4j2</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.role.v2.mgt.core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        EmailNotificationClientTest statically mocks IdentityUtil (via Mockito's
                        inline mock maker - see src/test/resources/mockito-extensions), which
                        depends more heavily on Byte Buddy than the default subclass mock maker;
                        Byte Buddy predates official JDK 21 support, and this is the one-line
                        workaround its own error message documents.
                    -->
                    <systemPropertyVariables>
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*Constants.class</exclude>
                        <exclude>**/*Component.class</exclude>
                        <exclude>**/*DataHolder.class</exclude>
                        <!-- Plain request/response DTOs (getters/setters + a from() mapper) - moved
                             here from the endpoint module's bean package, which carried no
                             coverage requirement of its own. -->
                        <exclude>**/dto/*.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule implementation="org.jacoco.maven.RuleConfiguration">
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit implementation="org.jacoco.report.check.Limit">
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.8</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.name}</Bundle-Name>
                        <_dsannotations>*</_dsannotations>
                        <Private-Package>
                            org.wso2.dpdp.accelerator.complaint.mgt.service.internal,
                            org.wso2.dpdp.accelerator.complaint.mgt.service.impl
                        </Private-Package>
                        <Export-Package>
                            !org.wso2.dpdp.accelerator.complaint.mgt.service.internal,
                            !org.wso2.dpdp.accelerator.complaint.mgt.service.impl,
                            org.wso2.dpdp.accelerator.complaint.mgt.service.*;version="${project.version}"
                        </Export-Package>
                        <Import-Package>
                            org.wso2.dpdp.accelerator.complaint.mgt.dao;version="${project.version}",
                            org.wso2.dpdp.accelerator.complaint.mgt.dao.constants;version="${project.version}",
                            org.wso2.dpdp.accelerator.complaint.mgt.dao.exception;version="${project.version}",
                            org.wso2.dpdp.accelerator.complaint.mgt.dao.model;version="${project.version}",
                            org.wso2.dpdp.accelerator.common.config;version="${project.version}",
                            org.wso2.dpdp.accelerator.common.util;version="${project.version}",
                            org.osgi.framework;version="[1.8,2)",
                            com.fasterxml.jackson.annotation;version="${jackson.imp.pkg.version.range}",
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
