<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>dpdp-accelerator</artifactId>
        <version>1.0.0-alpha1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>org.wso2.dpdp.accelerator.identity.extensions</artifactId>
    <name>WSO2 DPDP Accelerator - Identity Extensions</name>
    <description>Identity Server side extensions for the DPDP accelerator</description>
    <packaging>bundle</packaging>

    <dependencies>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.event.notifications.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.event.notifications.service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.user.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.user.api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.commons</groupId>
            <artifactId>org.wso2.carbon.tenant.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.mgt</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.role.v2.mgt.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.api.resource.mgt</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.inbound.auth.oauth2</groupId>
            <artifactId>org.wso2.carbon.identity.oauth</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.organization.management.core</groupId>
            <artifactId>org.wso2.carbon.identity.organization.management.service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.consent.mgt</groupId>
            <artifactId>org.wso2.carbon.consent.mgt.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.consent.extensions</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.orbit.org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.governance</groupId>
            <artifactId>org.wso2.carbon.identity.governance</artifactId>
        </dependency>
        <dependency>
            <!-- AbstractEventHandler/Event/IdentityEventConstants for DPDPUserLifecycleEventHandler. -->
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.event</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <systemPropertyVariables>
                        <jacoco-agent.destfile>target/jacoco.exec</jacoco-agent.destfile>
                        <!-- Mockito's inline mock maker (needed to mock final methods on Carbon
                             classes like AbstractUserStoreManager) bundles a Byte Buddy version
                             that predates official JDK 21 support - this is Byte Buddy's own
                             documented opt-in to run anyway. -->
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*Constants.class</exclude>
                        <exclude>**/*Component.class</exclude>
                        <exclude>**/*DataHolder.class</exclude>
                        <exclude>**/*TenantMgtListener.class</exclude>
                        <exclude>**/*ConsentManagementListener.class</exclude>
                        <exclude>**/*ConsentExpiryReconciler.class</exclude>
                        <!-- Needs a live Quartz Scheduler and/or the carbon config directory. -->
                        <exclude>**/scheduler/*.class</exclude>
                        <exclude>**/*StartupObserver.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule implementation="org.jacoco.maven.RuleConfiguration">
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit implementation="org.jacoco.report.check.Limit">
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.8</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Private-Package>
                            org.wso2.dpdp.accelerator.identity.extensions.internal
                        </Private-Package>
                        <Export-Package>
                            !org.wso2.dpdp.accelerator.identity.extensions.internal,
                            org.wso2.dpdp.accelerator.identity.extensions.*;version="${project.version}",
                        </Export-Package>
                        <Import-Package>
                            org.wso2.dpdp.accelerator.common.config;version="${project.version}",
                            org.wso2.dpdp.accelerator.common.util;version="${project.version}",
                            org.wso2.dpdp.accelerator.event.notifications.common.enums;version="${project.version}",
                            org.wso2.dpdp.accelerator.event.notifications.common.listener;version="${project.version}",
                            org.wso2.dpdp.accelerator.event.notifications.service;version="${project.version}",
                            org.wso2.dpdp.accelerator.consent.extensions.service;version="${project.version}",
                            org.wso2.dpdp.accelerator.consent.extensions.service.constants;version="${project.version}",
                            org.wso2.dpdp.accelerator.consent.extensions.service.models;version="${project.version}",
                            org.wso2.dpdp.accelerator.consent.extensions.dao.exceptions;version="${project.version}",
                            org.wso2.dpdp.accelerator.consent.extensions.dao.models;version="${project.version}",

                            org.osgi.framework;version="${osgi.framework.imp.pkg.version.range}",
                            org.osgi.service.component;version="${osgi.service.component.imp.pkg.version.range}",
                            org.osgi.service.component.annotations;version="${osgi.service.component.imp.pkg.version.range}",
                            org.apache.commons.logging;version="${commons.logging.imp.pkg.version.range}",
                            com.google.gson;version="${gson.imp.pkg.version.range}",

                            org.wso2.carbon.context.*;version="${carbon.kernel.version}",
                            org.wso2.carbon.core;version="${carbon.kernel.version}",
                            org.wso2.carbon.utils.multitenancy;version="${carbon.kernel.version}",
                            org.wso2.carbon.user.core;version="${carbon.user.core.version}",
                            org.wso2.carbon.user.core.common;version="${carbon.user.core.version}",
                            org.wso2.carbon.user.core.service;version="${carbon.user.core.version}",
                            org.wso2.carbon.user.api;version="0",

                            org.wso2.carbon.stratos.common.beans;version="${carbon.tenant.common.version}",
                            org.wso2.carbon.stratos.common.exception;version="${carbon.tenant.common.version}",
                            org.wso2.carbon.stratos.common.listeners;version="${carbon.tenant.common.version}",

                            org.wso2.carbon.identity.application.common.model;version="${carbon.identity.application.common.version}",
                            org.wso2.carbon.identity.application.common;version="${carbon.identity.application.common.version}",
                            org.wso2.carbon.identity.application.mgt;version="${carbon.identity.application.mgt.version}",
                            org.wso2.carbon.identity.role.v2.mgt.core;version="${carbon.identity.role.mgt.core.version}",
                            org.wso2.carbon.identity.role.v2.mgt.core.model;version="${carbon.identity.role.mgt.core.version}",
                            org.wso2.carbon.identity.role.v2.mgt.core.exception;version="${carbon.identity.role.mgt.core.version}",
                            org.wso2.carbon.identity.api.resource.mgt;version="${carbon.identity.api.resource.mgt.version}",
                            org.wso2.carbon.identity.oauth;version="${carbon.identity.inbound.auth.oauth.version}",
                            org.wso2.carbon.identity.oauth.dto;version="${carbon.identity.inbound.auth.oauth.version}",
                            org.wso2.carbon.identity.core.util;version="${carbon.identity.core.version}",
                            org.wso2.carbon.identity.organization.management.service;version="${carbon.identity.organization.mgt.service.version}",
                            org.wso2.carbon.identity.organization.management.service.util;version="${carbon.identity.organization.mgt.service.version}",
                            org.wso2.carbon.identity.organization.management.service.exception;version="${carbon.identity.organization.mgt.service.version}",
                            org.wso2.carbon.consent.mgt.core;version="${carbon.consent.mgt.core.imp.pkg.version.range}",
                            org.wso2.carbon.consent.mgt.core.listener;version="${carbon.consent.mgt.core.imp.pkg.version.range}",
                            org.wso2.carbon.consent.mgt.core.model;version="${carbon.consent.mgt.core.imp.pkg.version.range}",
                            org.wso2.carbon.consent.mgt.core.exception;version="${carbon.consent.mgt.core.imp.pkg.version.range}",
                            !org.quartz.*,
                            org.wso2.carbon.identity.governance.service.notification;version="${carbon.identity.governance.version}",
                            org.wso2.carbon.identity.governance.model;version="${carbon.identity.governance.version}",
                            org.wso2.carbon.identity.governance.exceptions.notiification;version="${carbon.identity.governance.version}",
                            org.wso2.carbon.identity.event;version="${carbon.identity.event.version}",
                            org.wso2.carbon.identity.event.event;version="${carbon.identity.event.version}",
                            org.wso2.carbon.identity.event.handler;version="${carbon.identity.event.version}",
                            *
                        </Import-Package>
                        <!-- Quartz sits on Carbon's shared classpath, not an OSGi bundle, so nothing
                             exports org.quartz for a static Import-Package to resolve against.
                             `!org.quartz.*` stops bnd auto-adding an unresolvable entry from our
                             own `import org.quartz.Job`; DynamicImport-Package resolves it instead. -->
                        <DynamicImport-Package>*</DynamicImport-Package>
                        <_dsannotations>*</_dsannotations>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
