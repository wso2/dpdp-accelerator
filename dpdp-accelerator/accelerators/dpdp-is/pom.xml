<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>dpdp-accelerator-modules</artifactId>
        <version>1.0.0-alpha1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wso2-dpdpiam-accelerator</artifactId>
    <packaging>pom</packaging>
    <name>WSO2 DPDP Accelerator - Identity Server Accelerator</name>

    <dependencies>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>consent-portal</artifactId>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.consent.mgt.extensions.endpoint</artifactId>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.event.notifications.service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.event.notifications.endpoint</artifactId>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.identity.extensions</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.consent.extensions</artifactId>
        </dependency>
        <dependency>
            <!-- Copied onto Carbon's shared classpath below (see the copy-quartz-jar execution's
                 comment), not an OSGi dropin. -->
            <groupId>org.wso2.orbit.org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.endpoint</artifactId>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Clear the previous build's webapp and dropins overlay so removed/renamed files
                 do not linger alongside the fresh ones the antrun step below copies in. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-webapp-overlay</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>carbon-home/repository/deployment/server/webapps</directory>
                                </fileset>
                                <fileset>
                                    <directory>carbon-home/repository/components/dropins</directory>
                                </fileset>
                                <fileset>
                                    <directory>carbon-home/repository/components/lib</directory>
                                    <includes>
                                        <include>quartz-*.jar</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Quartz is placed on Carbon's shared classpath (repository/components/lib), not
                 installed as an OSGi bundle - it loads its JobStore/ThreadPool/driver-delegate
                 implementation classes by string name via reflection at scheduler-init time,
                 which doesn't reliably resolve through strict per-bundle OSGi imports alone.
                 Matches how the WSO2 Financial Services accelerator ships the same jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-quartz-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.wso2.orbit.org.quartz-scheduler</groupId>
                                    <artifactId>quartz</artifactId>
                                    <version>${quartz.version}</version>
                                    <destFileName>quartz-${quartz.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.basedir}/carbon-home/repository/components/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The consent portal ships pre-exploded so Carbon does not have to unpack it during startup. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-solution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy todir="${project.basedir}/carbon-home/repository/components/dropins">
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.event.notifications.common/target">
                                        <include name="*.jar"/>
                                    </fileset>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.event.notifications.dao/target">
                                        <include name="*.jar"/>
                                    </fileset>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.event.notifications.service/target">
                                        <include name="*.jar"/>
                                    </fileset>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.complaint.mgt.dao/target">
                                        <include name="*.jar"/>
                                    </fileset>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.complaint.mgt.service/target">
                                        <include name="*.jar"/>
                                    </fileset>
                                </copy>
                                <unzip src="../../react-apps/consent-portal/target/consent-portal.war"
                                       dest="${project.basedir}/carbon-home/repository/deployment/server/webapps/consent-portal"/>
                                <unzip src="../../internal-webapps/org.wso2.dpdp.accelerator.consent.mgt.extensions.endpoint/target/api#dpdp#consent-mgt#v1.war"
                                       dest="${project.basedir}/carbon-home/repository/deployment/server/webapps/api#dpdp#consent-mgt#v1"/>
                                <unzip src="../../internal-webapps/org.wso2.dpdp.accelerator.event.notifications.endpoint/target/api#dpdp#event-notifications#v1.war"
                                       dest="${project.basedir}/carbon-home/repository/deployment/server/webapps/api#dpdp#event-notifications#v1/"/>
                                <copy todir="${project.basedir}/carbon-home/repository/components/dropins">
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.identity.extensions/target"
                                              includes="org.wso2.dpdp.accelerator.identity.extensions-*.jar"/>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.common/target"
                                              includes="org.wso2.dpdp.accelerator.common-*.jar"/>
                                    <fileset dir="../../components/org.wso2.dpdp.accelerator.consent.extensions/target"
                                              includes="org.wso2.dpdp.accelerator.consent.extensions-*.jar"/>
                                </copy>
                                <unzip src="../../internal-webapps/org.wso2.dpdp.accelerator.complaint.mgt.endpoint/target/api#dpdp#complaints#v1.war"
                                       dest="${project.basedir}/carbon-home/repository/deployment/server/webapps/api#dpdp#complaints#v1/"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dpdp-is-accelerator</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <descriptors>
                                <descriptor>src/assembly/bin.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
