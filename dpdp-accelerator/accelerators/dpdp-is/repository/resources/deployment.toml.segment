# --- BEGIN WSO2 DPDP ACCELERATOR ---
# Enables the consent management v2 API. This single switch also renders the
# v2 rules into repository/conf/identity/resource-access-control-v2.xml and
# registers the v2 API resources and their internal_consent_mgt_* scopes, so
# none of those files should be edited by hand.
[consent_mgt]
enable_v2_api = true

# The consent portal's BFF validates the user's access token itself (it rejoins
# the split-cookie halves and forwards the token to the Identity Server APIs),
# so the server's own authentication valve must not gate these paths. Webapp
# contexts that are not listed here default to secured, which would reject the
# static assets and the login redirects before any servlet runs. The pattern has
# no slash before the wildcard so that the bare context path matches too.
[[resource.access_control]]
context = "(.*)/consent-portal(.*)"
secure = "false"
http_method = "all"
# --- END WSO2 DPDP ACCELERATOR ---
