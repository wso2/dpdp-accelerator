<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>consent-portal</display-name>

    <!-- Defaults; override via <IS_HOME>/repository/conf/dpdp-portal.properties. -->
    <context-param>
        <param-name>identity.server.base.url</param-name>
        <param-value>https://localhost:9443</param-value>
    </context-param>
    <context-param>
        <param-name>identity.server.internal.base.url</param-name>
        <param-value>https://localhost:9443</param-value>
    </context-param>
    <context-param>
        <param-name>oauth.client.id</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>oauth.client.secret</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>oauth.scopes</param-name>
        <param-value>openid internal_login internal_consent_mgt_consent_view internal_consent_mgt_consent_create internal_consent_mgt_consent_update internal_consent_mgt_purpose_view internal_consent_mgt_purpose_create internal_consent_mgt_purpose_update internal_consent_mgt_purpose_delete internal_consent_mgt_element_view internal_consent_mgt_element_create internal_consent_mgt_element_delete</param-value>
    </context-param>
    <context-param>
        <param-name>cookie.secure</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
      Client-side routes are served by SpaServlet, which is mapped at the
      context root. No 404 error-page fallback is used: it would answer a
      deep link with an error status, and it would turn a missing API route
      into an HTML page instead of the JSON envelope the SPA expects.
    -->
</web-app>
